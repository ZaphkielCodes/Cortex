{
  "$defs": {
    "Advertisement": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "title": "Capability Id",
          "type": "string"
        },
        "version": {
          "default": "1.0",
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$",
          "title": "Version",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "availability": {
          "default": "available",
          "enum": [
            "available",
            "unavailable",
            "degraded"
          ],
          "title": "Availability",
          "type": "string"
        },
        "evidence": {
          "enum": [
            "handler_registered",
            "session_handler",
            "legacy_report"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "permission_tier": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Permission Tier",
          "type": "integer"
        },
        "risk": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "required_permissions": {
          "items": {
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Required Permissions",
          "type": "array"
        },
        "privacy_class": {
          "default": "INTERNAL",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "PERSONAL",
            "SENSITIVE",
            "HIGHLY_SENSITIVE"
          ],
          "title": "Privacy Class",
          "type": "string"
        },
        "last_verified_at": {
          "default": null,
          "title": "Last Verified At",
          "type": "null"
        }
      },
      "required": [
        "capability_id",
        "input_schema",
        "output_schema",
        "evidence"
      ],
      "title": "Advertisement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1,
      "default": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "device_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "title": "Device Id",
      "type": "string"
    },
    "executor_location": {
      "const": "device",
      "default": "device",
      "title": "Executor Location",
      "type": "string"
    },
    "generation": {
      "default": 0,
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "ttl_seconds": {
      "default": 90,
      "maximum": 120,
      "minimum": 15,
      "title": "Ttl Seconds",
      "type": "integer"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Advertisement"
      },
      "maxItems": 96,
      "title": "Capabilities",
      "type": "array"
    }
  },
  "required": [
    "device_id",
    "capabilities"
  ],
  "title": "AdvertisementBatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
