# Cortex Hub â€” Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# --- LLM Provider ---
# direct (default), groq, nvidia, gemini, ollama, or mock (tests only).
CORTEX_LLM_PROVIDER=direct
# Groq key is shared by reasoning and voice transcription.
GROQ_API_KEY=
CORTEX_GROQ_MODEL=qwen/qwen3.8-27b
# NVIDIA development endpoints are opt-in and PUBLIC-data-only.
NVIDIA_API_KEY=
CORTEX_ENABLE_NVIDIA_TRIAL=0
# CORTEX_NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# Gemini joins the direct router when its key is configured; privacy policy still applies.
GEMINI_API_KEY=
# CORTEX_GEMINI_MODEL=gemini-3.8-flash
# Vision defaults to Groq when reasoning uses direct/groq/nvidia.
# CORTEX_VISION_PROVIDER=groq

# Structured inference has a bounded 30-second budget across direct route attempts.
# CORTEX_DEADLINE_STRUCTURED_TOTAL=30

# --- Voice ---
# GROQ_API_KEY above also configures transcription.

# --- Network ---
# CORTEX_HUB_HOST=0.0.0.0
# CORTEX_HUB_PORT=8000
# CORTEX_ALLOW_LAN=false

# --- Security ---
# CORTEX_AUTH_TIMEOUT=10
# CORTEX_CONFIRMATION_TIMEOUT=60
# CORTEX_COMMAND_TTL=300

# --- Web & Weather Capabilities (Phase A1) ---
# Search Provider: "duckduckgo" (default, free), "tavily", "brave", or "mock"
CORTEX_SEARCH_PROVIDER=duckduckgo
CORTEX_SEARCH_API_KEY=
# CORTEX_SEARCH_ENABLED=true

# Weather Provider: "open-meteo" (default, free) or "mock"
CORTEX_WEATHER_PROVIDER=open-meteo
CORTEX_WEATHER_API_KEY=
# Local reasoning (requires an actually installed Ollama model; no automatic download)
# CORTEX_LLM_PROVIDER=ollama
# CORTEX_LOCAL_MODEL=<installed model name>
# CORTEX_OLLAMA_URL=http://127.0.0.1:11434
# CORTEX_HOST_LOCALITY=local_device
# CORTEX_REASONING_ROUTE=local
# CORTEX_LOCAL_MODEL_TIMEOUT=90
# Direct file receive is opt-in and confined to this folder.
# CORTEX_RECEIVE_ROOT=C:\Users\your-user\Downloads\CortexReceived
# CORTEX_TRANSFER_BIND=127.0.0.1
# CORTEX_TRANSFER_ADVERTISE_HOST=127.0.0.1
# CORTEX_TRANSFER_PORT=0
# CORTEX_WEATHER_ENABLED=true


# Request progress includes context preparation; network deadlines remain bounded.
CORTEX_REQUEST_ACK_SECONDS=3
CORTEX_PREPARATION_TIMEOUT=30
CORTEX_HUB_REPLY_TIMEOUT=15
# Runtime identity defaults to the actual hostname; set an enrolled alias if used.
# CORTEX_HUB_DEVICE_ID=<this hub's device ID>
# Native desktop execution on the hub is disabled; normally use the enrolled agent.
CORTEX_ENABLE_HUB_DESKTOP=0

# Local model context budgets (no extra summarization API calls).
CORTEX_HISTORY_MAX_CHARS=4000
CORTEX_REASONING_CONTEXT_BYTES=4000
CORTEX_TOOL_CONTEXT_BYTES=6000

# Maximum bounded wait for an actual provider 429/cooldown; never replays actions.
CORTEX_PROVIDER_RATE_WAIT_SECONDS=65

# AgentTurn reasoning uses this configured direct model when eligible; approvals still pin the recipient.
CORTEX_REASONING_MODEL=openai/gpt-oss-120b

# Optional routing profile hints (JSON array of ModelProfile objects; no secrets).
# CORTEX_MODEL_PROFILE_PATH=path/to/model-profiles.json
# Relevant provider health persists under CORTEX_STATE_DIR/provider-health.json.

# A11 Google integrations. Explicit consent is required per account/capability.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORTEX_GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/callback
# Maps calls remain disabled until the project/APIs/billing are explicitly enabled.
GOOGLE_MAPS_API_KEY=
CORTEX_GOOGLE_MAPS_ENABLED=0
